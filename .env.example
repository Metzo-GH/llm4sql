# PostgreSQL Configuration
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=llm4sql_db
DB_USER=llm4sql_user
DB_PASSWORD=llm4sql_password

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
# Fallback CLI/script model (the Web UI switches installed models dynamically)
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=90.0

# Environment settings
ENV=development
