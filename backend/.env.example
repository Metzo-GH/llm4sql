# PostgreSQL Configuration
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=llm4sql_db
DB_USER=your_db_user_here
DB_PASSWORD=your_secure_password_here

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
# Modèle de repli (fallback CLI/scripts). Non nécessaire pour l'interface Web (sélection dynamique des modèles installés)
OLLAMA_MODEL=your_local_model_here
OLLAMA_TIMEOUT=90.0

# Environment settings
ENV=development
